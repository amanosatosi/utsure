+static const char *cache_desc_name(const CacheDesc *desc)
+{
+    if (desc == &font_cache_desc)
+        return "font";
+    if (desc == &bitmap_cache_desc)
+        return "bitmap";
+    if (desc == &composite_cache_desc)
+        return "composite";
+    if (desc == &outline_cache_desc)
+        return "outline";
+    if (desc == &face_size_metrics_cache_desc)
+        return "face_size_metrics";
+    if (desc == &glyph_metrics_cache_desc)
+        return "glyph_metrics";
+    return "unknown";
+}
