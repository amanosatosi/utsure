+
+static void cache_dump_limited_string(const char *label, const char *text)
+{
+    if (!text)
+        return;
+    fprintf(stderr, "  %s=\"", label);
+    for (int i = 0; i < 160; i++) {
+        if (!cache_memory_readable(text + i, 1))
+            break;
+        unsigned char c = (unsigned char) text[i];
+        if (!c)
+            break;
+        if (c == '\n')
+            fputs("\\n", stderr);
+        else if (c == '\r')
+            fputs("\\r", stderr);
+        else if (c == '\t')
+            fputs("\\t", stderr);
+        else if (c >= 0x20 && c < 0x7f)
+            fputc(c, stderr);
+        else
+            fprintf(stderr, "\\x%02x", c);
+    }
+    fputs("\"\n", stderr);
+}
+
+static void cache_dump_value_bytes(void *value)
+{
+    if (!cache_memory_readable(value, 32)) {
+        fprintf(stderr, "  value_bytes=<unreadable>\n");
+        return;
+    }
+
+    unsigned char *bytes = value;
+    fprintf(stderr, "  value_bytes=");
+    for (int i = 0; i < 32; i++)
+        fprintf(stderr, "%s%02x", i ? " " : "", bytes[i]);
+    fputc('\n', stderr);
+}
+
+static void cache_abort_invalid(const char *op, const char *caller,
+                                void *value, const CacheDesc *expected_desc,
+                                const char *reason)
+{
+    fprintf(stderr,
+            "libass/mangetsu cache pointer corruption: op=%s caller=%s "
+            "value=%p expected=%s reason=%s\n",
+            op, caller ? caller : "unknown", value,
+            expected_desc ? cache_desc_name(expected_desc) : "any", reason);
+    fprintf(stderr, "  pts_ms=%lld\n", cache_debug_pts);
+    cache_dump_limited_string("style", cache_debug_style);
+    cache_dump_limited_string("actor", cache_debug_actor);
+    cache_dump_limited_string("event_text", cache_debug_event_text);
+    cache_dump_value_bytes(value);
+    fflush(stderr);
+    abort();
+}
+
+static CacheItem *cache_validate_value(void *value, const char *op,
+                                       const char *caller,
+                                       const CacheDesc *expected_desc)
+{
+    if (!value)
+        return NULL;
+
+    if (((uintptr_t) value & (CACHE_ALIGN - 1)) != 0)
+        cache_abort_invalid(op, caller, value, expected_desc,
+                            "cache value pointer is not aligned");
+
+    CacheItem *item = value_to_item(value);
+    if (!cache_memory_readable(item, sizeof(*item)))
+        cache_abort_invalid(op, caller, value, expected_desc,
+                            "cache item header is unreadable");
+    if (item->magic != CACHE_ITEM_MAGIC)
+        cache_abort_invalid(op, caller, value, expected_desc,
+                            "cache item magic does not match");
+    if (!cache_desc_is_known(item->desc))
+        cache_abort_invalid(op, caller, value, expected_desc,
+                            "cache item descriptor is unknown");
+    if (expected_desc && item->desc != expected_desc)
+        cache_abort_invalid(op, caller, value, expected_desc,
+                            "cache item descriptor type mismatch");
+    if (!item->size || item->size > SIZE_MAX / 2)
+        cache_abort_invalid(op, caller, value, expected_desc,
+                            "cache item size is implausible");
+    if (!item->ref_count || item->ref_count > SIZE_MAX / 2)
+        cache_abort_invalid(op, caller, value, expected_desc,
+                            "cache item refcount is implausible");
+    if (item->cache) {
+        if (!cache_memory_readable(item->cache, sizeof(*item->cache)))
+            cache_abort_invalid(op, caller, value, expected_desc,
+                                "cache owner pointer is unreadable");
+        if (item->cache->desc != item->desc)
+            cache_abort_invalid(op, caller, value, expected_desc,
+                                "cache owner descriptor mismatch");
+    }
+
+    return item;
+}
+
+static void cache_validate_list_item(CacheItem *item, const CacheDesc *desc)
+{
+    if (!cache_memory_readable(item, sizeof(*item))) {
+        cache_abort_invalid("cache_get", __func__,
+                            item ? (char *) item + CACHE_ITEM_SIZE : NULL,
+                            desc, "cache map item header is unreadable");
+    }
+    if (item->magic != CACHE_ITEM_MAGIC || item->desc != desc ||
+            !item->size || !item->ref_count) {
+        cache_abort_invalid("cache_get", __func__,
+                            (char *) item + CACHE_ITEM_SIZE, desc,
+                            "cache map item header is invalid");
+    }
+}
