+static bool cache_desc_is_known(const CacheDesc *desc)
+{
+    return desc == &font_cache_desc ||
+           desc == &bitmap_cache_desc ||
+           desc == &composite_cache_desc ||
+           desc == &outline_cache_desc ||
+           desc == &face_size_metrics_cache_desc ||
+           desc == &glyph_metrics_cache_desc;
+}
